// eval/cases.jsonc
// Runnable definition of the 5 binary criteria in eval/criteria.md for the
// CRM Report Card Tier 0 build. Each case names the criterion it proves and
// an exact command to run from the repo root. All commands exit non-zero on
// failure. Cases 1-3 and 5 are pytest node ids; case 4 is a shell command
// ending in a grep assertion (there is no dedicated pytest test for it).
{
  "fixture_csv": "fixtures/messy-crm-sample.csv",
  "fixture_expected": "fixtures/messy-crm-sample.expected.json",
  "cases": [
    {
      "id": 1,
      "criterion": "duplicate_records matches expected.json on the golden fixture",
      // Runs the full scan on the golden fixture and asserts duplicate_records
      // and overall_grade equal the values in fixtures/messy-crm-sample.expected.json.
      "command": "python3 -m pytest tests/test_scan.py::test_golden_fixture_matches_expected -q"
    },
    {
      "id": 2,
      "criterion": "a 403 domain is reported under bot_blocked, never dead",
      // Asserts classify(403, False) buckets to bot_blocked (not dead), and
      // that a domain returning 403 is counted in bot_blocked with dead == 0.
      "command": "python3 -m pytest tests/test_liveness.py::test_classify_buckets tests/test_liveness.py::test_bot_blocked_never_counted_dead -q"
    },
    {
      "id": 3,
      "criterion": "every AI number in the rendered HTML is inside an ESTIMATE-tagged element",
      // Renders HTML with an ai_baseline block present and asserts the
      // qualified-percent figure is wrapped in the ESTIMATE / NOT VERIFIED tag.
      "command": "python3 -m pytest tests/test_render_html.py::test_render_html_labels_and_cta -q"
    },
    {
      "id": 4,
      "criterion": "the rendered HTML contains no raw CRM row values from the input CSV, only aggregates",
      // Runs the CLI scan then render on the golden fixture into a scratch
      // dir, then greps the produced HTML for a raw contact email that only
      // exists in the source CSV row data. The command fails (grep -q finds
      // it) if a raw row value ever leaks into the report.
      "command": "set -e; d=$(mktemp -d); python3 -c \"import json,sys; open(sys.argv[1],'w').write(json.dumps({'icp_nl':'US B2B SaaS','critical_properties':['email'],'field_mapping':{},'contact_email':'a@b.co','booking_url':'https://cal.example/x','favorite_customers':[]}))\" \"$d/run-config.json\"; PYTHONPATH=scripts python3 -m crm_report_card.cli scan --config \"$d/run-config.json\" --csv fixtures/messy-crm-sample.csv --out \"$d/metrics.json\" >/dev/null; PYTHONPATH=scripts python3 -m crm_report_card.cli render --metrics \"$d/metrics.json\" --config \"$d/run-config.json\" --out \"$d/card.html\" >/dev/null; ! grep -q 'jane.ross@brightloop.com' \"$d/card.html\""
    },
    {
      "id": 5,
      "criterion": "sanitization guard passes: no secret or internal path leak in any shippable file",
      "command": "python3 -m pytest tests/test_sanitization.py -q"
    }
  ]
}
